# Build-time overrides for src/config.js. Everything else is set in that file.

# Base URL of the FastAPI backend (no trailing slash). Default: http://localhost:8000
VITE_API_URL=https://your-backend.vercel.app

# How often the page polls the backend for newer data, in seconds. Default: 30
# VITE_STATUS_POLL_SECONDS=30

# MapLibre style URL for the basemap. Default: CARTO Dark Matter
# VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
